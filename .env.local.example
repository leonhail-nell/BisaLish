# Copy this file to .env.local and fill in one of the two keys.

# Pick a provider: "anthropic" or "openai"
AI_PROVIDER=anthropic

# --- If using Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-xxxx
# Recommended: claude-sonnet-4-6 (best Cebuano quality, won't confuse Bisaya with Tagalog).
# Cheaper alternative: claude-haiku-4-5-20251001 — faster but more likely to mix Tagalog into Bisaya.
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- If using OpenAI ---
OPENAI_API_KEY=sk-xxxx
# Model options: gpt-4o-mini (cheap) or gpt-4o (higher quality)
OPENAI_MODEL=gpt-4o-mini

# Optional: simple per-IP rate limit (requests per minute). Leave empty to disable.
RATE_LIMIT_PER_MINUTE=20
